// CMake 가 configure 시점에 생성하는 파일 (TestPaths.h). 직접 수정하지 말 것.
#pragma once
#include <filesystem>

namespace pa_test_paths
{
    // 실제 바이너리 위치. 파일이 없으면 해당 통합 테스트는 SKIP 된다.
    inline const std::filesystem::path kHrtfDll = L"@PA_LIB_DIR_RELEASE@/HrtfDsp.dll";
    inline const std::filesystem::path kPreprocessorDll = L"@PA_LIB_DIR_RELEASE@/Triton.Preprocessor.dll";
    inline const std::filesystem::path kLocalProcessorExe = L"@PA_PROCESSOR_DIR@/Triton.LocalProcessor.exe";
    // e2e 테스트의 작업 폴더 (빌드 폴더 하위)
    inline const std::filesystem::path kScratchDir = L"@CMAKE_CURRENT_BINARY_DIR@/scratch";
} // namespace pa_test_paths
